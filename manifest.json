{
  "manifest_version": 3,
  "name": "X Video Downloader",
  "short_name": "x-video-dl",
  "version": "2.0.0",
  "description": "Download videos and GIFs from X (Twitter) with one click directly in your feed.",
  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://api.vxtwitter.com/*",
    "https://api.fxtwitter.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "X Video Downloader Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["*://*.x.com/*", "*://*.twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}